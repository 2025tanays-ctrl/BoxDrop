{
  "info": {
    "name": "BoxDrop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Tanay Shelar\", \"email\": \"tanay@example.com\", \"password\": \"12345678\"}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"tanay@example.com\", \"password\": \"12345678\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Get All Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/plans"
          }
        },
        {
          "name": "Get Plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/plans/search?keyword=skincare"
          }
        },
        {
          "name": "Create Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Book Lovers Box\", \"description\": \"Books and accessories\", \"category\": \"books\", \"price\": 899, \"billingCycle\": \"monthly\", \"products\": \"Novel, Bookmark, Reading Light\"}"
            },
            "url": "{{baseUrl}}/plans"
          }
        },
        {
          "name": "Update Plan",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"price\": 949}"
            },
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user\": \"{{userId}}\", \"plan\": \"{{planId}}\", \"preferences\": [\"Standard preference\"], \"billingCycle\": \"monthly\"}"
            },
            "url": "{{baseUrl}}/subscriptions"
          }
        },
        {
          "name": "Get User Subscriptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/subscriptions/user/{{userId}}"
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/subscriptions/{{subscriptionId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "Get Shipments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/shipments/subscription/{{subscriptionId}}"
          }
        }
      ]
    }
  ]
}